# Optional. If this file exists, Cortex AGI uses this interpreter.
# Otherwise set 2PY2 to a portable / embeddable Python (not Python 2).
#
#   PYTHON=.venv/bin/python
#   PYTHON=.venv\Scripts\python.exe
#   PYTHON=C:\portable\python\python.exe
#
# A bare path on its own line also works.
PYTHON=python
